# --- required ---
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/bolchall
WEB_ORIGIN=http://localhost:3000
# Public base URL the API is reachable at (used for upload URLs).
# In dev: same as the API server. In prod: e.g. https://api.example.com
PUBLIC_API_URL=

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-random-48-bytes-hex
JWT_REFRESH_SECRET=replace-with-different-random-48-bytes-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# --- demo mode (skip Stripe entirely; "Upgrade" button just flips status) ---
BOLCHALL_DEMO_MODE=true

# --- optional: real Stripe (only used when BOLCHALL_DEMO_MODE=false) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- optional: Cloudinary signed uploads (otherwise base64 in Mongo, capped 2MB/file) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- optional: Resend email (logs to console if absent) ---
RESEND_API_KEY=
RESEND_FROM=Bolchall <noreply@bolchall.demo>

# ──────────────────────────────────────────────────────────────────────
# DEMO ACCOUNTS for local testing — credentials NOT exposed in the UI
# ──────────────────────────────────────────────────────────────────────
# When BOLCHALL_INCLUDE_DEMO_USERS=true, `pnpm seed` will (re)create the
# accounts below using DEMO_ACCOUNT_PASSWORD. Without this flag, `pnpm seed`
# only loads phonemes/exercises/achievements — no users get created and
# you bootstrap your first admin via `pnpm create-admin <email> <name> <pw>`.
BOLCHALL_INCLUDE_DEMO_USERS=false
DEMO_ACCOUNT_PASSWORD=ChangeMe@2026

# Admin
DEMO_ADMIN_EMAIL=admin@bolchall.demo

# Therapists (approved + one pending)
DEMO_DOCTOR_APPROVED_1_EMAIL=dr.priya@bolchall.demo
DEMO_DOCTOR_APPROVED_2_EMAIL=dr.raj@bolchall.demo
DEMO_DOCTOR_PENDING_EMAIL=dr.pending@bolchall.demo

# Patients — *_PAID is the paid-plan customer for testing premium flows
DEMO_PATIENT_PAID_EMAIL=patient.sara@bolchall.demo
DEMO_PATIENT_TRIAL_EMAIL=patient.alex@bolchall.demo
