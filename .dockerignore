# Skip everything that doesn't belong in the API image.
# Most importantly: web/ (Next.js app, deployed separately to Vercel)
# and node_modules (we install fresh inside the image).

node_modules
**/node_modules
.pnpm-store

# Web app — deployed to Vercel, not needed in api image
web

# Build outputs
**/dist
**/.next
**/build

# Git + local config
.git
.gitignore
.github

# Env files (env vars come from Koyeb dashboard, not the image)
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Logs + caches
*.log
npm-debug.log*
yarn-debug.log*
.npm
.cache
.pnpm-debug.log*

# Editor + OS
.vscode
.idea
.DS_Store
Thumbs.db

# Docs (not needed at runtime)
*.md
!api/README.md
